<?xml version="1.0" encoding="utf-8" ?>
<codetemplate	xmlns="http://schemas.borland.com/Delphi/2005/codetemplates"
				version="1.0.0">
	<template name="ifass" invoke="manual">
		<description>
            if assigned
		</description>
		<author>
            guiixta
		</author>
        <point name='variable'>
            <text>Variable</text>
        </point>
        <point name='code'>
        </point>
		<code language="Delphi"><![CDATA[if Assigned($variable$) then $code$]]>
		</code>
	</template>
</codetemplate>