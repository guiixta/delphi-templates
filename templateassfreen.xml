<?xml version="1.0" encoding="utf-8" ?>
<codetemplate	xmlns="http://schemas.borland.com/Delphi/2005/codetemplates"
				version="1.0.0">
	<template name="assfreen" invoke="manual">
		<description>
		  if assigned freeandnil
		</description>
		<author>
            guiixta
		</author>
        <point name="variable">
            <text>
                variable
            </text>
        </point>
		<code language="Delphi"><![CDATA[if Assigned($variable$) then
    FreeAndNil($variable$);]]>
		</code>
	</template>
</codetemplate>